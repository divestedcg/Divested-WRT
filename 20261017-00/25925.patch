From 5ff2b4a7a174583dee803cec4ce6788c2b84d8d4 Mon Sep 17 00:00:00 2001
From: John Audia <therealgraysky@proton.me>
Date: Fri, 16 Oct 2026 15:20:19 -0400
Subject: [PATCH 3/3] kernel: add kmod-crypto-krb5 for 6.18 rpcsec

Linux 6.18.57 backports upstream bf8672b99402 ("SUNRPC: Add Kconfig
dependency on CRYPTO_KRB5") and the series moving rpcsec_gss_krb5 to
crypto/krb5, as a stable dependency of b94f6719dcd9 ("SUNRPC: Reject
short RFC 4121 MIC tokens in gss_krb5_verify_mic_v2").
rpcsec_gss_krb5.ko now imports crypto_krb5_* from krb5.ko, which no
package ships, so kmod-fs-nfs-common-rpcsec fails its dependency check.

Package krb5.ko and krb5enc.ko as kmod-crypto-krb5 and depend on it on
6.18. krb5enc is not a symbol dependency but is loaded by name for the
AES-SHA1 enctypes.

Signed-off-by: John Audia <therealgraysky@proton.me>
---
 package/kernel/linux/modules/crypto.mk | 22 +++++++++++++++++++++-
 package/kernel/linux/modules/fs.mk     |  3 ++-
 2 files changed, 23 insertions(+), 2 deletions(-)

diff --git a/package/kernel/linux/modules/crypto.mk b/package/kernel/linux/modules/crypto.mk
index 2f853da7adeef5..f7389cea352722 100644
--- a/package/kernel/linux/modules/crypto.mk
+++ b/package/kernel/linux/modules/crypto.mk
@@ -561,6 +561,27 @@ endef
 
 $(eval $(call KernelPackage,crypto-kpp))
 
+
+define KernelPackage/crypto-krb5
+  TITLE:=Kerberos 5 crypto library
+  DEPENDS:=@!LINUX_6_12 +kmod-crypto-manager +kmod-crypto-authenc \
+	+kmod-crypto-hmac +kmod-crypto-cmac +kmod-crypto-sha1 \
+	+kmod-crypto-sha256 +kmod-crypto-sha512 +kmod-crypto-cbc \
+	+kmod-crypto-cts
+  KCONFIG:= \
+	CONFIG_CRYPTO_KRB5 \
+	CONFIG_CRYPTO_KRB5ENC \
+	CONFIG_CRYPTO_KRB5_SELFTESTS=n
+  FILES:= \
+	$(LINUX_DIR)/crypto/krb5enc.ko \
+	$(LINUX_DIR)/crypto/krb5/krb5.ko
+  AUTOLOAD:=$(call AutoLoad,09,krb5enc krb5)
+  $(call AddDepends/crypto)
+endef
+
+$(eval $(call KernelPackage,crypto-krb5))
+
+
 define KernelPackage/crypto-lib-chacha20
   TITLE:=ChaCha library interface
   KCONFIG:=CONFIG_CRYPTO_LIB_CHACHA
@@ -1129,4 +1150,3 @@ define KernelPackage/crypto-xxhash
 endef
 
 $(eval $(call KernelPackage,crypto-xxhash))
-
diff --git a/package/kernel/linux/modules/fs.mk b/package/kernel/linux/modules/fs.mk
index 09bc00fc2101bb..b7b0aaa7b0c6a7 100644
--- a/package/kernel/linux/modules/fs.mk
+++ b/package/kernel/linux/modules/fs.mk
@@ -493,7 +493,8 @@ define KernelPackage/fs-nfs-common-rpcsec
 	+kmod-crypto-sha256 \
 	+kmod-crypto-sha512 \
 	+kmod-crypto-cbc \
-	+kmod-crypto-cts
+	+kmod-crypto-cts \
+	+!LINUX_6_12:kmod-crypto-krb5
   KCONFIG:= \
 	CONFIG_SUNRPC_GSS \
 	CONFIG_RPCSEC_GSS_KRB5
