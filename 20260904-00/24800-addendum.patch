+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Tavi <tavi@divested.dev>
+Date: Fri, 4 Sep 2026 19:02:06 -0400
+Subject: [PATCH 01/31] Revert "netfilter: flowtable: ensure sufficient
+ headroom in xmit path"
+
+This reverts commit 1eb0dc458b6e8efc3a9cf02ec3ccd0f20576910e.
+---
+ net/netfilter/nf_flow_table_ip.c | 13 ++-----------
+ 1 file changed, 2 insertions(+), 11 deletions(-)
+
+diff --git a/net/netfilter/nf_flow_table_ip.c b/net/netfilter/nf_flow_table_ip.c
+index 1be506a175af..4dcc30e7f9e5 100644
+--- a/net/netfilter/nf_flow_table_ip.c
++++ b/net/netfilter/nf_flow_table_ip.c
+@@ -343,17 +343,8 @@ struct nf_flow_xmit {
+ static unsigned int nf_flow_queue_xmit(struct net *net, struct sk_buff *skb,
+ 				       struct nf_flow_xmit *xmit)
+ {
+-	struct net_device *dev = xmit->outdev;
+-	unsigned int hh_len = LL_RESERVED_SPACE(dev);
+-
+-	if (unlikely(skb_headroom(skb) < hh_len && dev->header_ops)) {
+-		skb = skb_expand_head(skb, hh_len);
+-		if (!skb)
+-			return NF_STOLEN;
+-	}
+-
+-	skb->dev = dev;
+-	dev_hard_header(skb, dev, ntohs(skb->protocol),
++	skb->dev = xmit->outdev;
++	dev_hard_header(skb, skb->dev, ntohs(skb->protocol),
+ 			xmit->dest, xmit->source, skb->len);
+ 	dev_queue_xmit(skb);
+ 
